# Terraform
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/*.tfvars
!**/*.example.tfvars

# Node / build artifacts
node_modules/
dist/
build/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/.pytest_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local-only overrides (e.g. corporate CA bundles for TLS-intercepting networks)
bootstrap/values/*.local.yaml
